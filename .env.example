# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Optional regex for trusted preview domains, for example Netlify deploy previews.
CORS_ORIGIN_REGEX=

# Frontend (copy this value into frontend/.env.local when needed)
FRONTEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CACHE_DIR=./data/cache/huggingface
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=benchmark_evidence
TOP_K=5
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Benchmark ingestion
DATASET_MODE=development
SQUAD_SAMPLE_SIZE=250
TRUTHFULQA_SAMPLE_SIZE=250

# Milestone 2/3 evaluation
DATABASE_PATH=./data/evaluations.db
SUPPORT_THRESHOLD=0.62
CONTRADICTION_THRESHOLD=0.55
COMPLETENESS_THRESHOLD=0.60
RELEVANCE_WEIGHT=0.20
ACCURACY_WEIGHT=0.35
GROUNDEDNESS_WEIGHT=0.25
COMPLETENESS_WEIGHT=0.20
