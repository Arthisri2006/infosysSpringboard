# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (copy this value into frontend/.env.local when needed)
FRONTEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CACHE_DIR=./data/cache/huggingface
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=benchmark_evidence
TOP_K=5
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Benchmark ingestion
DATASET_MODE=development
SQUAD_SAMPLE_SIZE=250
TRUTHFULQA_SAMPLE_SIZE=250
